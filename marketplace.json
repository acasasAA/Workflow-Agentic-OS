    },
    {
      "name": "wos-jira",
      "source": { "source": "local", "path": "./plugins/jira" },
      "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
      "category": "Productivity"
    },
    {
      "name": "wos-project",
      "source": { "source": "local", "path": "./plugins/project" },
      "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
      "category": "Productivity"
    }
