{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${plugin_root}/hooks/on-session-start.ps1",
            "timeout": 15,
            "statusMessage": "Workflow OS: resume project context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${plugin_root}/hooks/on-stop.ps1",
            "timeout": 30,
            "statusMessage": "Workflow OS: session-summary"
          }
        ]
      }
    ]
  }
}
