{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${plugin_root}/hooks/on-session-start.ps1",
            "timeout": 10,
            "statusMessage": "Workflow OS: resume task context"
          }
        ]
      }
    ]
  }
}
